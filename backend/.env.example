# 变量清单；Spring Boot 不自动加载本文件，请配置在运行环境或 IDEA 中。
# 五个服务必须使用同一个至少 32 字符随机密钥。
BANK_INTERNAL_TOKEN=
# 用户服务：demo 模式默认不创建用户，启用时必须提供自选密码。
BANK_CREDENTIAL_STORE=demo
BANK_DEMO_ENABLED=false
BANK_DEMO_IDENTITY=demo-user
BANK_DEMO_PASSWORD=
BANK_SESSION_TTL=30m
BANK_MAX_SESSIONS=10000
# 切换 BANK_CREDENTIAL_STORE=mysql 后由用户服务使用。
BANK_DB_URL=jdbc:mysql://localhost:3306/payment_db?serverTimezone=Asia/Shanghai&characterEncoding=UTF-8
BANK_DB_USERNAME=bank_user
BANK_DB_PASSWORD=
