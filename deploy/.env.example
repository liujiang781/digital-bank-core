# 环境变量模板：复制为 .env 后填写真实值
# .env / .env.local 不进仓库；Spring Boot 不会自动读取 .env，需由启动脚本或 IDE 注入
# 本文件按各服务实际读取的变量名整理；仓库 backend/.env.example 是 user-service 的原始模板，
# 其中 DB_URL / DB_USERNAME / DB_PASSWORD / JWT_SECRET 为旧通用名，服务不读取，统一用下方分服务变量。

# ---- MySQL 容器（仅 Docker Compose 使用）----
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=payment_db
MYSQL_PORT=3306

# ---- Redis（可选，当前后端未使用）----
REDIS_PORT=6379

# ---- 服务间内部令牌：至少 32 字符随机串，四个值各自独立生成 ----
BANK_INTERNAL_TOKEN=change_me_at_least_32_chars_random
ACCOUNT_INTERNAL_TOKEN=change_me_at_least_32_chars_random
TRANSACTION_INTERNAL_TOKEN=change_me_at_least_32_chars_random
RISK_INTERNAL_TOKEN=change_me_at_least_32_chars_random

# ---- user-service（8081）----
BANK_DB_URL=jdbc:mysql://127.0.0.1:3306/payment_db?serverTimezone=Asia/Shanghai&characterEncoding=utf8
BANK_DB_USERNAME=bank_user
BANK_DB_PASSWORD=change_me
# 必须是 mysql：demo=内置演示账号，jdbc=旧写法
BANK_CREDENTIAL_STORE=mysql
BANK_DEMO_ENABLED=false
BANK_DEMO_IDENTITY=demo-user
BANK_DEMO_PASSWORD=
BANK_SESSION_TTL=30m
BANK_MAX_SESSIONS=10000

# ---- account-service（8082）----
ACCOUNT_DB_URL=jdbc:mysql://127.0.0.1:3306/payment_db?serverTimezone=Asia/Shanghai&characterEncoding=utf8
ACCOUNT_DB_USER=account_service
ACCOUNT_DB_PASSWORD=change_me

# ---- transaction-service（8083）----
TRANSACTION_DB_URL=jdbc:mysql://127.0.0.1:3306/payment_db?serverTimezone=Asia/Shanghai&characterEncoding=utf8
TRANSACTION_DB_USER=transaction_service
TRANSACTION_DB_PASSWORD=change_me
# SUCCESS / FAILED / UNKNOWN（UNKNOWN 模拟渠道超时，联调结束恢复 SUCCESS）
MOCK_CHANNEL_RESULT=SUCCESS
RECOVERY_INTERVAL_MILLIS=10000
RECOVERY_INITIAL_DELAY_MILLIS=10000

# ---- risk-service（8084）----
RISK_DB_URL=jdbc:mysql://127.0.0.1:3306/payment_db?serverTimezone=Asia/Shanghai&characterEncoding=utf8
RISK_DB_USER=risk_service
RISK_DB_PASSWORD=change_me

# ---- gateway（团队口径 8080；S4 本机 8080 被 NI 占用，改用 8085）----
# SERVER_PORT 不要写进本文件：五个服务共用会一起绑到同一端口，只剩一个能起。
# 只在网关进程启动时单独设置，例如：set SERVER_PORT=8085 && .\mvnw.cmd -pl gateway spring-boot:run
USER_SERVICE_URL=http://localhost:8081
ACCOUNT_SERVICE_URL=http://localhost:8082
TRANSACTION_SERVICE_URL=http://localhost:8083
RISK_SERVICE_URL=http://localhost:8084

# ---- 前端 ----
VITE_API_BASE_URL=/api
