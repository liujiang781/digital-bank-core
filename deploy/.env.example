# 复制为 .env 后填写真实值，.env 不进仓库
# docker compose 会自动读取同目录的 .env

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=bank_core
MYSQL_PORT=3306

# ---- Redis（可选，不用就不启）----
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- 后端 ----
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:mysql://localhost:3306/bank_core?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USERNAME=root
DB_PASSWORD=change_me
JWT_SECRET=change_me_to_a_random_string

# ---- 前端 ----
VITE_API_BASE_URL=/api
