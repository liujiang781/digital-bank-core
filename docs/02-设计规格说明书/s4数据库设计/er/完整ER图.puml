  {field} * rule_id : VARCHAR(32)  <<FK>>
  {field} * rule_version : INT
  {field} * operator_identity_id : VARCHAR(64)
  {field} * reason_code : VARCHAR(32)
  {field} * result : VARCHAR(16)
  {field} * created_at : DATETIME
  {field} * updated_at : DATETIME
  {field} * version : INT UNSIGNED
}

entity "审计日志表\naudit_log" as audit_log {
  {field} * id : BIGINT UNSIGNED  <<PK>>
  {field} * operator_identity_id : VARCHAR(64)
  {field} * action : VARCHAR(32)
  {field} * target_type : VARCHAR(32)
  {field} target_ref : VARCHAR(64)
  {field} reason : VARCHAR(255)
  {field} result : VARCHAR(16)
  {field} trade_no : VARCHAR(32)
  {field} ip_address : VARCHAR(45)
  {field} * created_at : DATETIME
  {field} * updated_at : DATETIME
  {field} * version : INT UNSIGNED
}

customer ||--o{ credential : 拥有凭证
customer ||--o{ account : 持有账户
account ||--o{ account_status_log : 状态历史
account ||-down-o{ transaction : 主账户交易
transaction ||-left-o{ transaction_flow : 产生流水
account ||--o{ transaction_flow : 账户流水
transaction ||-right-o| transfer_order : 转账明细
account ||--o{ transfer_order : 付款方
account |o--o{ transfer_order : 收款方（本行）
transaction ||-down-o{ risk_event : 风险记录
risk_rule ||--o{ risk_event : 规则命中
risk_rule -[hidden]right- audit_log
legend bottom left
  PK = 主键；FK = 物理外键；U1/U2/U3 = 本表唯一约束（同号字段组成联合唯一键）。
  字段前 ● 表示 NOT NULL；无 ● 表示可空。 || = 恰好 1；o| = 0 或 1；o{ = 0 到多。
  关联引用业务唯一键（customer_id / account_id / trade_no / rule_id），不引用自增 id。
  transaction → transfer_order 为 1 : 0..1：非转账交易没有转账单。
  payee_account_id 可空：本行转账必须关联账户；跨行转账使用外部收款信息。
  identity_id / operator_identity_id 属应用层身份引用，不创建 customer 外键。
  audit_log 独立留存；trade_no / target_ref 为逻辑引用，不创建物理外键。
  可用余额 = book_balance − reserved_amount，为派生值，不单独落库。
endlegend
@enduml
