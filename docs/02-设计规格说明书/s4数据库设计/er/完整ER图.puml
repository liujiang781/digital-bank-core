  {field} * amount : DECIMAL(18,2)
  {field} * currency : CHAR(3)
  {field} * status : VARCHAR(16)
  {field} channel_evidence_id : VARCHAR(64)
  {field} last_channel_result : VARCHAR(32)
  {field} last_checked_at : DATETIME
  {field} failure_reason : VARCHAR(255)
  {field} accepted_at : DATETIME
  {field} completed_at : DATETIME
  {field} * created_at : DATETIME
  {field} * updated_at : DATETIME
