entity "客户表\ncustomer" as customer {
  {field} * id : BIGINT UNSIGNED  <<PK>>
  {field} * customer_id : VARCHAR(32)  <<U1>>
  {field} * identity_id : VARCHAR(64)  <<U2>>
  {field} * name : VARCHAR(100)
  {field} phone : VARCHAR(20)  <<U3>>
  {field} email : VARCHAR(100)
  {field} * real_name_status : VARCHAR(16)
  {field} * status : VARCHAR(16)
  {field} * created_at : DATETIME
  {field} * updated_at : DATETIME
  {field} * version : INT UNSIGNED
}

entity "登录凭证表\ncredential" as credential {
  {field} * id : BIGINT UNSIGNED  <<PK>>
  {field} * customer_id : VARCHAR(32)  <<FK>>
  {field} * username : VARCHAR(50)  <<U1>>
  {field} * password_hash : VARCHAR(255)
  {field} * credential_type : VARCHAR(16)
  {field} * status : VARCHAR(16)
  {field} * created_at : DATETIME
  {field} * updated_at : DATETIME
