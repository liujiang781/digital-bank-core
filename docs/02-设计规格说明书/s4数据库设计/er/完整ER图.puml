  {field} outgoing_daily_limit : DECIMAL(18,2)
  {field} * enabled : TINYINT(1)
  {field} * rule_version : INT
  {field} * created_at : DATETIME
  {field} * updated_at : DATETIME
  {field} * version : INT UNSIGNED
}

entity "风险事件表\nrisk_event" as risk_event {
  {field} * id : BIGINT UNSIGNED  <<PK>>
  {field} * event_id : VARCHAR(32)  <<U1>>
