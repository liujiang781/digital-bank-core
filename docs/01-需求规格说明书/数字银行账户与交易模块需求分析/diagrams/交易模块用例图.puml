@startuml
left to right direction
skinparam defaultFontName Microsoft YaHei
skinparam monochrome true
skinparam shadowing false
skinparam backgroundColor white
skinparam packageStyle rectangle
actor "客户\nACT-C" as C
actor "运营人员\nACT-O" as O
rectangle "模拟资金渠道\nACT-F" as F <<actor>>
rectangle "模拟外部银行\nACT-B" as B <<actor>>
rectangle "数字银行核心业务模拟系统 / 交易模块" {
  usecase "UC-TR-01\n办理存款" as DP
  usecase "UC-TR-02\n办理取款" as WD
  usecase "UC-TR-03\n办理本行转账" as IT
  usecase "UC-TR-04\n办理跨行转账" as XB
  usecase "UC-TR-05\n查询交易结果" as RES
  usecase "UC-TR-06\n查询交易流水" as LOG
  usecase "UC-TR-07\n下载交易回单" as RECEIPT
  usecase "UC-TR-08\n核对待确认交易" as CHECK
  usecase "UC-TR-09\n重试资金恢复" as RECOVER
}
C -- DP
C -- WD
C -- IT
C -- XB
C -- RES
C -- LOG
C -- RECEIPT
O -- RES
O -- LOG
O -- RECEIPT
O -- CHECK
O -- RECOVER
DP -- F
WD -- F
CHECK -- F
XB -- B
CHECK -- B
@enduml
